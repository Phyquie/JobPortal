// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id            String        @id @default(uuid())
  title         String
  location      String
  pin           String
  type          JobType
  salary        Int
  skills        String?
  category      JobCategory
  description   String
  Applications  Application[]
  createdBy     String // User ID of the job creator
  createdByUser User?         @relation(fields: [createdBy], references: [clerkId])
  companyId     String? // Optional relation to Company model
  company       Company?      @relation(fields: [companyId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  SavedJob      SavedJob[]
}

enum JobType {
  full_time
  part_time
  contract
  internship
}

enum JobCategory {
  engineering
  product
  data
  marketing
  design
  sales
  hr
  finance
  other
}

enum ApplicationStatus {
  delivered
  seen
  rejected
}

model Application {
  id          String            @id @default(uuid())
  jobId       String
  userId      String
  status      ApplicationStatus
  resumeUrl   String? // URL to stored resume in S3 or file server
  coverLetter String? // URL to stored cover letter in S3 or file server
  user        User              @relation(fields: [userId], references: [clerkId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id])
}

model SavedResume {
  id        String   @id @default(uuid())
  userId    String
  fileUrl   String // URL to stored resume in S3 or file server
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String
  clerkId        String        @unique
  email          String        @unique
  savedResumeUrl String? //
  Job            Job[]
  company        Company[]
  applications   Application[]
  SavedJob       SavedJob[]
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId])
  logoUrl     String? // URL to company logo image
  jobs        Job[]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [clerkId])
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
